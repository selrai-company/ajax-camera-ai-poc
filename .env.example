# Which Claude backend to use:
#   subscription = local `claude -p` CLI on your claude.ai login (testing only, never for customers)
#   api          = Anthropic API (production). Needs ANTHROPIC_API_KEY.
CAMAI_CLAUDE_BACKEND=subscription
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: TypeSafe Jev for the fixed-question checks side-by-side test
# JEV_API_KEY=
# JEV_BASE_URL=

# Where events, media and the model-response cache are stored
CAMAI_DATA=data
